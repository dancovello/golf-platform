# Copy to .env for local development. Never commit real values.
# Local Postgres from docker-compose.yml (dev data, schema auto-sync on).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/golf_dev
# Any long random string locally: openssl rand -hex 32
PAYLOAD_SECRET=
# Encrypts everyone's two-factor secrets. 64 hex characters: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
