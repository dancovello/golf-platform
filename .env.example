# Copy to .env for local development. Never commit real values.
# Local Postgres from docker-compose.yml (dev data, schema auto-sync on).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/golf_dev
# Any long random string locally: openssl rand -hex 32
PAYLOAD_SECRET=
# Encrypts everyone's two-factor secrets. 64 hex characters: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Photos and videos (src/media/storage.ts). Locally: the SeaweedFS stand-in for Cloudflare R2
# from docker-compose.yml. Its keys are local-only and not secret.
MEDIA_S3_ENDPOINT=http://127.0.0.1:8333
MEDIA_S3_BUCKET=golf-media-dev
MEDIA_S3_ACCESS_KEY_ID=localdev
MEDIA_S3_SECRET_ACCESS_KEY=localdev-secret
MEDIA_PUBLIC_URL=http://127.0.0.1:8333/golf-media-dev

# Email through Resend (src/email/adapter.ts). Leave blank locally: nothing is sent.
RESEND_API_KEY=
# The sending address on the platform's verified domain. Blank: Resend's test address.
EMAIL_FROM_ADDRESS=
# Staging and previews: send every email to this one address instead.
EMAIL_OVERRIDE_TO=
# The admin's own address, used for links in emails (e.g. password reset). Not a secret.
# Without it, "Forgot password?" is off. e.g. https://staging.example.com
ADMIN_URL=

# Cloudflare Turnstile, the Contact form's spam check (src/site/contact/turnstile.ts). Off
# unless both are set. The site key is public; the secret key is a secret.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Error alerts (src/monitoring/sentry.ts). Leave empty locally; set in Vercel for production
# and staging (docs/operations/monitoring.md).
SENTRY_DSN=
