# Copy to .env for local development. Never commit real values.
# Local Postgres from docker-compose.yml (dev data, schema auto-sync on).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/golf_dev
# Any long random string locally: openssl rand -hex 32
PAYLOAD_SECRET=
# Encrypts everyone's two-factor secrets. 64 hex characters: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Photos and videos (src/media/storage.ts). Locally: the SeaweedFS stand-in for Cloudflare R2
# from docker-compose.yml. Its keys are local-only and not secret.
MEDIA_S3_ENDPOINT=http://127.0.0.1:8333
MEDIA_S3_BUCKET=golf-media-dev
MEDIA_S3_ACCESS_KEY_ID=localdev
MEDIA_S3_SECRET_ACCESS_KEY=localdev-secret
MEDIA_PUBLIC_URL=http://127.0.0.1:8333/golf-media-dev
